# Placeholders: none.
#
# Hook 1 — secret read-guard. PreToolUse, matcher "Bash|PowerShell|Read".
# Denies a tool call that would open a credential-bearing file.
#
# WHY THIS IS FIELD-BASED AND NOT A GREP OVER THE PAYLOAD:
# The obvious implementation — grep the raw stdin JSON for `.env` — denies `git status`,
# `cat .gitignore`, and any command whose text merely mentions the word. The team then turns the
# hook off, and the one control that actually blocks something is gone. Match the field that
# carries the target: file_path for Read, and the individual arguments of command for Bash.
#
# WHY THE BASH BRANCH TOKENISES: whole-string matching cannot tell `cat .env` from
# `cat .env.example`, because the second contains the first.
#
# AND WHY TOKENISING IS THE FLOOR, NOT THE CEILING: a Bash call carries no file_path, so every
# word is a candidate path — including the words of a sentence. Splitting on whitespace alone
# denied `echo "=== LEDGER .env ==="`, `git commit -m "chore: ignore .env"` and
# `gh pr create --body "... .env ..."`: prose, opening nothing. Those denials look like the guard
# working, so they get worked around instead of reported, and the workaround ends at turning the
# hook off. The tokeniser below drops the words nothing opens. See its own header.
#
# KNOWN, INTENTIONAL FALSE POSITIVE: `cp .env.example .env` is denied, because one of its
# arguments is a bare `.env`. Creating a credential file is a step for a human, so the guard is
# right to stop the agent doing it unprompted — but say so in the report, because it reads as a
# bug the first time it fires.
#
# WHAT IT DOES NOT COVER, deliberately:
#   - Files pulled in with @-references in a prompt. Claude Code inlines those while building the
#     prompt, with no tool call, so NO PreToolUse hook fires — including this one. Cover that with
#     a `Read` deny rule in permissions, not with a hook.
#   - `dotnet user-secrets`. It is the recommended way to hold local secrets in .NET; blocking it
#     breaks legitimate work to prevent nothing.
#   - Grep and Glob. They can surface a secret's contents. Add them to the matcher if the team
#     wants that, and accept the false positives on repo-wide searches.
#   - `.envrc` (direnv). Add it to SECRET_PATTERNS if the team uses direnv.
#   - A path built at runtime: `cat "$SECRET_FILE"` names no file any tokeniser can see.
#
# TO WIDEN IT to writes as well as reads, add Edit|Write|MultiEdit to the matcher in
# settings.json. The file_path branch below already handles them.
#
# ---8<--- everything above this line is instructions for you; delete it ---8<---
#!/usr/bin/env bash
# `set -u` only, deliberately. `pipefail` turns SIGPIPE into a failed pipeline, so a filter that
# short-circuits — `grep -q`, `head -1` — makes the whole guard silently fall through to allow.
# That failure is invisible: the hook exits 0 and nothing is blocked. See references/hook-catalog.md.
set -u

DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/_lib.sh"

hook_read_stdin

# Names that ARE the credential, not a reference to one. Anchored on a path, assignment or
# argument boundary so `deploy/keys/` does not match `.key` and `ENV_FILE=.env` still does.
# The comma is in the set because an interpreter program is one token until the tokeniser splits
# it: `perl -e "open(F,'.env')"` re-scans to `F,.env`, and without the comma the file reads as the
# tail of an identifier. A space is deliberately NOT in the set — that is what keeps a whole
# quoted sentence from matching. Keep this list short: every pattern is a promise that the team
# will not have to argue with it.
SECRET_PATTERNS='(^|[/=,])\.env($|\.)|\.(pem|pfx|p12|jks|keystore|publishsettings)$|(^|[/=,])id_(rsa|dsa|ecdsa|ed25519)$|(^|[/=,])secrets\.json$|(^|[/=,])appsettings\.[Ss]ecrets\.json$|(^|/)\.ssh/|(^|/)\.aws/credentials$'

# Committed on purpose, hold no secret, and are the thing the agent should read instead. Checked
# BEFORE the patterns and never stripped from the name: stripping `.example` off `.env.example`
# leaves `.env`, and the guard then blocks the very file it is meant to point at.
TEMPLATE_RE='\.(example|sample|template|dist)$'

is_secret() {
  printf '%s' "$1" | grep -Eq "$TEMPLATE_RE" && return 1
  printf '%s' "$1" | grep -Eq "$SECRET_PATTERNS"
}

# operands <command-string> — the arguments of the command that could name a file to open, one
# per line, unquoted.
#
# The awk below is a small shell tokeniser. It is not a shell parser and does not try to be: it
# tracks quoting, command separators, heredocs and redirections, which is enough to tell an
# operand from a sentence. What it DROPS, each because nothing opens it:
#
#   1. operands of a text emitter (echo, printf, :) — output, not input.
#   2. the body of a heredoc, and the word after `<<<` — data fed to a command, not a file name.
#      A substitution inside either still runs, and is still re-scanned; a quoted delimiter
#      (`<<'EOF'`) turns expansion off, and only then is the body literal all the way down.
#   3. the value of --message/--body/--title/--notes, and of -m/-b/-t when the command is git or
#      gh — a message is prose by definition, and these are the flags an agent uses to commit and
#      to open a PR. The short forms are gated on the command name because they mean something
#      else everywhere else: `cat -t .env` and `sort -b .env` carry no message, and skipping the
#      word after the flag skipped the file being read.
#   4. the first non-flag operand of grep/sed/awk and friends — that is the pattern or the
#      script. `grep -n '\.env' .gitignore` reads .gitignore; the `.env` is what it looks FOR.
#
# What it does NOT drop, and the rules that cost the most to get right:
#
#   - A quoted argument holding spaces is kept WHOLE rather than split into words. Split, the
#     sentence "adds .env to .gitignore" yields a bare `.env` and the commit is denied. Whole, it
#     cannot match: SECRET_PATTERNS anchors on the start of the token or on `/`, `=` or `,`, and
#     a space is none of those — while `cat "my dir/.env"` still matches on the slash. The comma
#     is in the set for interpreter argument lists (`open(F,'.env')`); putting a comma in the
#     tokeniser's separators instead would break brace expansion, which needs its commas inside
#     the token.
#   - Unless the command RUNS that argument. `bash -c "cat .env"` and `ssh host "cat .env"` are
#     opens wearing a sentence's clothes, so the argument is re-scanned as a command of its own.
#     Without this rule, `-c` is a one-character bypass of the whole guard.
#   - A command substitution inside any argument — EVERY argument, before any rule above gets to
#     drop it: a message, a heredoc word, an assignment, an operand of `echo`. `echo "$(cat .env)"`
#     runs `cat` whatever the outer command is, and each branch that dropped a token used to drop
#     the substitution inside it too, which made every one of them a one-argument bypass.
#     Only the text INSIDE `$(...)` or backticks is re-scanned, never the whole token: nesting all
#     of `echo "adds .env $(date)"` would turn prose back into an operand list and re-deny exactly
#     the case this tokeniser exists to allow. `$(...)` closes at the BALANCED paren — closing at
#     the last one in the token dragged `... (see PR)` back in, and one prose parenthesis was
#     enough to deny an ordinary commit message.
#   - A wrapper does not name the command. `sudo`, `env`, `timeout`, `nohup`, `xargs`, `nice` and
#     friends take arguments of their own first; the rules above are decided on the word the
#     wrapper actually runs, not on the wrapper. Decided on the wrapper, `sudo git commit -m` never
#     saw a `git`, never skipped the `-m`, and re-scanned the commit message as a command.
#
# The command name itself IS emitted: `./.env` as a command is still an open. A brace expansion is
# emitted as its alternatives too, since `cat {.env,.env.local}` opens two files under names that
# survive nowhere as a single token.
#
# A redirection target is emitted even inside a suppressed segment, because `>` and `<` open a
# file whatever the command is. `echo x > .env` stays denied.
operands() {
  # JSON escapes -> real separators, BEFORE any backslash is removed. A multi-line Bash command
  # arrives as the two characters \ and n. Strip the backslash first and `cat .env\necho done`
  # fuses into the single token `.envnecho`, which the anchored pattern misses — and Claude Code
  # emits multi-line Bash constantly, so that is the NORMAL case, not an exotic one. Newline must
  # survive as a newline here: it ends a command and closes a heredoc.
  #
  # `\"` becomes a real quote in the same pass. A double-quoted argument reaches us as \"src/.env\"
  # — the payload's own escaping — and a tokeniser that does not undo it sees the quote as part of
  # the word: `"src/.env"` fails the anchored pattern, and a quoted operand walks straight through.
  # It also breaks the opposite case, splitting a -m message into loose words the skip cannot
  # cover. Only `\"` is undone, and only after json_path has already resolved `\\`; the general
  # un-escaping that _lib.sh warns against is still not attempted here.
  printf '%s' "$1" \
    | sed -E 's/\\n/\
/g; s/\\[rt]/ /g; s/\\"/"/g' \
    | awk '
    { src = src $0 "\n" }

    function basename(p) { sub(/.*\//, "", p); return p }

    # One operand out. A brace expansion goes out as its alternatives as well as whole.
    function emit(t,   pre, mid, post, k, arr, j) {
      print t
      if (t ~ /\{[^{}]*,[^{}]*\}/) {
        pre = t;  sub(/\{[^{}]*,[^{}]*\}.*/, "", pre)
        post = t; sub(/^[^{}]*\{[^{}]*,[^{}]*\}/, "", post)
        mid = t;  sub(/^[^{}]*\{/, "", mid); sub(/\}.*/, "", mid)
        k = split(mid, arr, ",")
        for (j = 1; j <= k; j++) print pre arr[j] post
      }
    }

    # Re-scan an argument as a command in its own right, by appending it to the source still to be
    # read. Bounded, because a crafted payload should not be able to make this loop forever.
    #
    # The budget counts BYTES APPENDED, not calls. A call counter spends the whole allowance on
    # four ordinary substitutions — `cd "$(git rev-parse --show-toplevel)"`, `echo "$(git branch
    # --show-current)"` — and then stops scanning the rest of the command in silence, which is the
    # worst shape a guard can fail in. Bytes bound the loop just as hard and are not exhausted by
    # commands an agent writes all day.
    function nest(t) {
      if (nested + length(t) <= 8000) { src = src "\n" t "\n"; n = length(src); nested += length(t) }
    }

    # Start of a new command: the next word is a command name, and the per-segment state resets.
    function newseg() { seg_first = 1; skip_next = 0; wrapping = 0; classify("") }

    # What a command name means for the rest of its segment. Split out of the seg_first branch
    # because a wrapper does not name the command: `sudo git commit -m ...` is still git, and the
    # classification has to happen again on the word the wrapper actually runs.
    function classify(t,   base) {
      base = basename(t)
      suppress   = (base ~ /^(echo|printf|:)$/)
      shellish   = (base ~ /^(sh|bash|zsh|ksh|dash|ssh|env|xargs|eval|sudo|doas|nohup|timeout|watch)$/)
      patternish = (base ~ /^(grep|egrep|fgrep|rg|ag|ack|sed|awk)$/)
      # Only these take a message in a SHORT flag; -t and -b mean something else elsewhere.
      msgish     = (base ~ /^(git|gh|hub|glab)$/)
      # Interpreters whose -e is a program, not a pattern or an escape switch.
      evalish    = (base ~ /^(node|nodejs|python|python[23]|perl|ruby|deno|bun)$/)
      # Commands that run another command. They take arguments of their own first, so the real
      # command name is further along the segment.
      wrapping   = (base ~ /^(env|xargs|sudo|doas|nohup|timeout|watch|stdbuf|nice|command)$/)
    }

    # Skip the heredoc body: everything up to a line that is exactly the delimiter.
    #
    # If the delimiter never arrives, the command is truncated or malformed — and swallowing the
    # rest of the payload would make an unterminated `<<EOF` an off switch for the whole guard.
    # Fail CLOSED instead: rewind to where the body started and tokenise it as ordinary commands.
    # Progress is still guaranteed, because the rewind lands past the `<<` that opened it.
    # A substitution in the body still RUNS, unless the delimiter was quoted, which is what
    # turns expansion off. The body is data for the command; a substitution in it is not.
    function skip_heredoc(   line, raw, nl, start) {
      start = i
      while (i <= n) {
        nl = index(substr(src, i), "\n")
        if (nl == 0) { i = start; return }
        raw = substr(src, i, nl - 1)
        i += nl
        line = raw
        gsub(/^[ \t]+|[ \t]+$/, "", line)
        if (line == delim) return
        if (!delim_quoted) nestsubs(raw)
      }
      i = start
    }

    # Index of the `)` that closes the `$(` starting at p in src, or 0 if it never closes.
    # Quote-aware, for the same reason nestsubs is: a paren inside quotes is text, not structure.
    function subend(p,   d3, c3, q3) {
      p += 2; d3 = 1; q3 = ""
      while (p <= n && d3 > 0) {
        c3 = substr(src, p, 1)
        if (q3 == "") {
          if (c3 == "\\") p++
          else if (c3 == "'"'"'" || c3 == "\"") q3 = c3
          else if (c3 == "(") d3++
          else if (c3 == ")") d3--
        } else if (q3 == "\"") {
          if (c3 == "\\") p++
          else if (c3 == "\"") q3 = ""
        } else if (c3 == "'"'"'") q3 = ""
        if (d3 > 0) p++
      }
      return (d3 == 0) ? p : 0
    }

    # Nest the text inside EVERY `$(...)` and every backtick pair in a token — the text inside
    # only, never the whole token, or the prose around a substitution becomes an operand list again
    # and the guard re-denies the commit messages this tokeniser exists to allow.
    #
    # The `$(...)` scan counts parentheses and stops at the BALANCED closer. Stopping at the last
    # `)` in the token instead is what dragged `... (see PR)` back into the re-scan: the sentence
    # after the substitution came along for the ride, and `echo "$(date) adds .env to .gitignore
    # (see PR)"` was denied. One prose paren is all it took.
    #
    # An unterminated substitution fails CLOSED: the rest of the token is scanned as a command,
    # for the same reason skip_heredoc rewinds rather than swallowing the payload.
    function nestsubs(t,   j, c2, d2, start, L) {
      L = length(t)
      j = 1
      while (j <= L) {
        if (substr(t, j, 2) == "$(") {
          j += 2; start = j; d2 = 1; q = ""
          while (j <= L && d2 > 0) {
            c2 = substr(t, j, 1)
            # Parens only count OUTSIDE quotes. In `$(printf "'"'"')"'"'"'; cat .env)` the scan used to
            # close on the `)` that printf is merely PRINTING, so the read after it fell out of the
            # re-scan while bash still ran it. Single quotes escape nothing; the double-quoted and
            # bare states both honour a backslash.
            if (q == "") {
              if (c2 == "\\") j++
              else if (c2 == "'"'"'" || c2 == "\"") q = c2
              else if (c2 == "(") d2++
              else if (c2 == ")") d2--
            } else if (q == "\"") {
              if (c2 == "\\") j++
              else if (c2 == "\"") q = ""
            } else if (c2 == "'"'"'") q = ""
            if (d2 > 0) j++
          }
          if (d2 == 0) { nest(substr(t, start, j - start)); j++ }
          else { nest(substr(t, start)); return }
          continue
        }
        if (substr(t, j, 1) == "`") {
          j++; start = j
          while (j <= L && substr(t, j, 1) != "`") j++
          if (j <= L) { nest(substr(t, start, j - start)); j++ }
          else { nest(substr(t, start)); return }
          continue
        }
        j++
      }
    }

    END {
      n = length(src)
      i = 1
      nested = 0
      newseg()
      delim = ""
      delim_quoted = 0
      redir = 0

      while (i <= n) {
        c = substr(src, i, 1)

        if (c == " " || c == "\t") { i++; continue }

        if (c == "\n") {
          i++
          # A heredoc opened on this line: its body starts now.
          if (delim != "") { skip_heredoc(); delim = "" }
          newseg()
          continue
        }

        # `<<<` feeds a string, `<<` opens a heredoc, a lone `<` or `>` redirects a file.
        if (c == "<" || c == ">") {
          if (substr(src, i, 3) == "<<<") { i += 3; skip_next = 1; continue }
          if (substr(src, i, 2) == "<<") {
            i += 2
            if (substr(src, i, 1) == "-") i++
            while (i <= n && (substr(src, i, 1) == " " || substr(src, i, 1) == "\t")) i++
            delim = ""; delim_quoted = 0
            while (i <= n) {
              c = substr(src, i, 1)
              if (c == " " || c == "\t" || c == "\n" || c == ";" || c == "|" || c == "&") break
              # A quoted delimiter turns expansion off: the body is then literal data.
              if (c == "\"" || c == "'"'"'") delim_quoted = 1
              else if (c != "\\") delim = delim c
              i++
            }
            continue
          }
          i++
          redir = 1
          continue
        }

        # Command separators. `(` `)` and a backtick open a subshell, which is a new command too.
        if (index(";|&()`", c) > 0) { i++; newseg(); continue }

        # One word, with quotes resolved.
        tok = ""; quoted = 0
        while (i <= n) {
          c = substr(src, i, 1)
          if (c == "'"'"'") {
            quoted = 1; i++
            while (i <= n && substr(src, i, 1) != "'"'"'") {
              c = substr(src, i, 1)
              tok = tok c; i++
            }
            i++
            continue
          }
          if (c == "\"") {
            quoted = 1; i++
            while (i <= n && substr(src, i, 1) != "\"") {
              # A `$(...)` inside double quotes resets quoting for ITS OWN body, so the next `"` in
              # the text is not necessarily the end of the outer string. Reading it as one closed
              # the token early on `echo "$(printf "(" ; cat .env)"` and the read fell out of the
              # token entirely. Copy the whole substitution across and let nestsubs take it apart.
              if (substr(src, i, 2) == "$(") {
                e = subend(i)
                if (e > 0) { tok = tok substr(src, i, e - i + 1); i = e + 1; continue }
              }
              c = substr(src, i, 1)
              if (c == "\\") { i++; c = substr(src, i, 1) }
              tok = tok c; i++
            }
            i++
            continue
          }
          if (c == " " || c == "\t" || c == "\n" || index(";|&()<>`", c) > 0) break
          if (c == "\\") { i++; c = substr(src, i, 1) }
          tok = tok c; i++
        }

        if (tok == "") continue

        # EVERY token, before any branch below decides to drop it. A substitution runs its own
        # command wherever it sits — in a commit message, in a heredoc word, in an assignment, in
        # an operand of `echo`. Each branch that dropped a token used to drop the substitution
        # inside it too, and each of those was a one-argument bypass of the whole guard.
        nestsubs(tok)

        if (redir) { emit(tok); redir = 0; continue }

        if (seg_first) {
          # A leading VAR=value is an assignment, not the command name: `ENV_FILE=.env cat "$f"`
          # keeps looking for the real command, and the assignment itself is still an operand.
          if (tok ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { emit(tok); continue }
          seg_first = 0
          classify(tok)
          emit(tok)
          continue
        }

        if (skip_next) { skip_next = 0; continue }

        # `-c` does not carry prose, it carries a command — mark the segment, do not skip.
        if (tok == "-c") { shellish = 1; wrapping = 0; continue }
        if (evalish && (tok == "-e" || tok == "--eval")) { shellish = 1; wrapping = 0; continue }

        # Still inside the arguments of the wrapper itself — its flags, a `timeout` duration, an
        # `env` assignment. The next word that is none of those is the command that actually runs,
        # so classify that one. Deciding the message flags on the wrapper instead is what denied
        # `sudo git commit -m "chore: ignore .env"`: `git` never set msgish, `-m` was never
        # skipped, and the commit message came back as a command to re-scan.
        if (wrapping) {
          if (tok ~ /^-/ || tok ~ /^[0-9]+(\.[0-9]+)?[smhd]?$/ || tok ~ /^[A-Za-z_][A-Za-z0-9_]*=/) { emit(tok); continue }
          classify(tok)
          emit(tok)
          continue
        }

        if (tok ~ /^(--message|--body|--title|--notes)$/) { skip_next = 1; continue }
        if (msgish && tok ~ /^(-m|-b|-t)$/) { skip_next = 1; continue }

        # A sentence handed to a shell is a command. Anywhere else it stays whole (see the header)
        # and the anchors in SECRET_PATTERNS decide. Spaces are NOT required: `python -c
        # "open('.env')"` is one word and still runs a program.
        if (quoted && shellish) { nest(tok); continue }

        if (suppress) continue

        # The first non-flag operand of grep/sed/awk is the pattern or the script, not a file.
        if (patternish && tok !~ /^-/) { patternish = 0; continue }

        emit(tok)
      }
    }
  '
}

TOOL="$(json_raw tool_name)"

case "$TOOL" in
  Bash|PowerShell)
    CMD="$(json_path command)"
    [ -z "$CMD" ] && exit 0
    # Trailing glob characters go, so `cat .env*` still reads as `.env`. A glob that does not
    # spell the name — `cat .en?` — still passes. That is deliberate evasion rather than a
    # mistake, and this guard is a guardrail against mistakes. See the header of
    # block-dangerous-bash.sh.
    HIT="$(operands "$CMD" \
      | sed -E 's/[*?]+$//; s/[,;:]+$//' \
      | grep -v -E "$TEMPLATE_RE" \
      | grep -m1 -E "$SECRET_PATTERNS")"
    [ -z "$HIT" ] && exit 0
    ;;
  *)
    # Read, and Edit/Write/MultiEdit if the matcher was widened. Always absolute, per the docs.
    TARGET="$(json_path file_path)"
    # No readable target means no decision. Never guess: an unreadable payload that denied by
    # default would block the whole session the first time the schema changes.
    [ -z "$TARGET" ] && exit 0
    is_secret "$TARGET" || exit 0
    ;;
esac

hook_deny "Blocked: that path is a credential file (.env, *.pem/pfx/p12, id_rsa/id_ed25519, secrets.json, appsettings.Secrets.json, .ssh/, .aws/credentials). Use the committed .example/.sample/.template file instead, or ask the user for the value you need."
