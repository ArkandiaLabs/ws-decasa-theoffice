# Placeholders: none.
#
# Hook 7 — generated-file guard. PreToolUse, matcher "Edit|Write|MultiEdit".
# Denies hand-editing files that a tool owns.
#
# INSTALL EACH BRANCH ONLY WHEN ITS ARTIFACT EXISTS. The lock-file branch needs
# packages.lock.json in the repo; the migrations branch needs an EF Core Migrations directory.
# Neither depends on the deterministic instrumentation having run — it depends on the file being
# there. Phase 1 decides; delete the branch that does not apply and say so in the report.
#
# WHY THESE TWO: both are regenerated from something else, so a hand edit is not a change, it is
# a change that will be silently reverted the next time anyone runs the generator — or worse, one
# that survives and makes the generated state disagree with its source. packages.lock.json is
# derived from the project files; a migration is derived from the model plus its own snapshot,
# and editing one by hand desynchronises ModelSnapshot.cs from the migration list.
#
# ---8<--- everything above this line is instructions for you; delete it ---8<---
#!/usr/bin/env bash
# `set -u` only. See the note in secret-read-guard.sh.
set -u

DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
. "$DIR/_lib.sh"

hook_read_stdin

FILE="$(json_path file_path)"
[ -z "$FILE" ] && exit 0

# Lock files are the output of restore. Editing one makes --locked-mode fail in CI with an error
# that points at a package, not at the edit.
case "$FILE" in
  */packages.lock.json|packages.lock.json)
    hook_deny 'Blocked: packages.lock.json is generated by restore, not edited. Change the version in Directory.Packages.props (or the project file) and run `dotnet restore`. To take a deliberate re-resolution, run `dotnet restore --force-evaluate`.'
    ;;
esac

# EF Core owns its Migrations/. A hand-written migration desynchronises ModelSnapshot.cs, and the
# next `migrations add` then generates a diff against a model state that never existed.
#
# But `Migrations/` is not proof of EF Core. DbUp and FluentMigrator use the same directory name
# for migrations that are written BY HAND, by design — blocking those stops the team's normal work
# and, worse, tells them to run `dotnet ef migrations add`, which is wrong for their tool. The
# ModelSnapshot file is what makes a directory EF Core's; require it before denying.
case "$FILE" in
  */Migrations/*|Migrations/*)
    MIGDIR="${FILE%/Migrations/*}/Migrations"
    if ls "$MIGDIR"/*ModelSnapshot.cs >/dev/null 2>&1; then
      hook_deny 'Blocked: files under Migrations/ are generated by EF Core. To change the schema, edit the entity or its configuration and run `dotnet ef migrations add <Name>`. To undo the last one, `dotnet ef migrations remove`.'
    fi
    ;;
esac

exit 0
