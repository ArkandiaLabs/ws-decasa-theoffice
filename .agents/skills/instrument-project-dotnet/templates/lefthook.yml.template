# Placeholders:
#   {{SOLUTION_PATH}}  — e.g. src/TheOffice.slnx or src/TheOffice.sln. Use whichever the repo
#                        actually has: .slnx has been supported since SDK 9.0.200, and .NET 10
#                        made it the default for `dotnet new sln`, so both are current.
#
# Repo root. Activate with `make hooks` (`lefthook install`).
#
# Lefthook is a single binary with no runtime dependency:
#   macOS    brew install lefthook
#   Windows  winget install evilmartians.lefthook
#   Linux    go install github.com/evilmartians/lefthook@latest
#
# Design: fast on pre-commit (staged files only), thorough on pre-push. A pre-commit that takes
# 30 seconds gets disabled within a week.
#
# IF THE PRE-COMMIT GETS SLOW in a large solution, move `format` to pre-push (which already runs
# `make check`) and leave pre-commit with `secrets` alone. Do NOT swap in
# `dotnet format whitespace --folder`: it looks like a cheap win and it is a silent gate. Two
# reasons, both measured — in --folder mode `--include` is resolved relative to the folder, so the
# repo-root paths lefthook passes in {staged_files} match nothing and the command exits 0; and the
# whitespace subcommand does not evaluate style rules, so unsorted and unused `using` directives
# sail through. Solution mode is slower because it loads the MSBuild workspace, and that workspace
# is what makes it a real gate.
#
# The commit-msg block is EVIDENCE-BASED, not a default. Phase 1 reads `git log --oneline -20`:
# keep the block only when the existing subjects already follow Conventional Commits. If they do
# not, delete it and say so in the report — imposing a commit convention is a team decision, not
# an instrumentation fix, and a hook nobody agreed to is the first one disabled.
# Drop the `secrets` command if the team opted out of secret scanning.
#   macOS    brew install gitleaks
#   Windows  winget install gitleaks
#   Linux    apt install gitleaks on Debian trixie+ / Ubuntu 25.04+; on older LTS take the
#            binary from https://github.com/gitleaks/gitleaks/releases
# Delete this header before writing the file.

pre-commit:
  parallel: true
  # Merges and rebases replay commits that already passed these checks, and a conflict resolution
  # is a bad moment to be blocked by a formatter. Without this the team disables the hook.
  skip:
    - merge
    - rebase
  commands:
    format:
      glob: "*.cs"
      run: dotnet format {{SOLUTION_PATH}} --no-restore --verify-no-changes --include {staged_files}
      fail_text: "Style: run `make format` and re-stage."
    secrets:
      run: gitleaks protect --staged --no-banner --redact
      fail_text: "Possible secret in the staged changes. If it is a false positive, add its fingerprint to .gitleaksignore."

commit-msg:
  commands:
    conventional:
      run: |
        # fixup!/squash!/amend! are git's own prefixes for autosquash; revert and merge commits
        # are generated by git too. Rejecting them blocks ordinary workflow, not bad messages.
        head -1 {1} | grep -qE '^((fixup|squash|amend)! |Revert |Merge )' && exit 0
        head -1 {1} | grep -qE '^(feat|fix|docs|style|refactor|perf|test|chore|build|ci)(\(.+\))?!?: .{1,72}$' \
          || { echo "Expected format: type(scope): description"; exit 1; }

pre-push:
  commands:
    check:
      run: make check
      fail_text: "`make check` failed. Fix it before pushing."

# Emergency exit: LEFTHOOK=0 git commit …
# It exists on purpose — a gate with no escape hatch gets uninstalled instead of skipped.
