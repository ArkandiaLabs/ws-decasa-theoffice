@host = http://localhost:5226

### Catalogo: primera pagina
GET {{host}}/api/v1/products
Accept: application/json

### Catalogo: segunda pagina
GET {{host}}/api/v1/products?page=2&pageSize=6
Accept: application/json

### Catalogo: filtro por categoria
GET {{host}}/api/v1/products?category=tecnologia
Accept: application/json

### Catalogo: busqueda por texto
GET {{host}}/api/v1/products?search=silla
Accept: application/json

### Detalle de producto
GET {{host}}/api/v1/products/PRD-005
Accept: application/json

### Crear producto
POST {{host}}/api/v1/products
Content-Type: application/json

{
  "publicId": "PRD-017",
  "name": "Tablero acrilico 120 x 90 cm",
  "description": "Tablero acrilico con marco de aluminio y bandeja portamarcadores.",
  "price": 215000,
  "imageUrl": "https://placehold.co/600x400/png?text=Tablero",
  "stock": 14,
  "categorySlug": "organizacion"
}

### v2 Catalogo: listado con foto principal y disponibilidad
GET {{host}}/api/v2/products
Accept: application/json

### v2 Catalogo: filtro por categoria
GET {{host}}/api/v2/products?category=mobiliario
Accept: application/json

### v2 Detalle: galeria completa y presentaciones, incluidas las agotadas
GET {{host}}/api/v2/products/PRD-005
Accept: application/json

### v2 Crear producto con galeria y presentaciones
POST {{host}}/api/v2/products
Content-Type: application/json

{
  "publicId": "PRD-018",
  "name": "Silla ejecutiva reclinable",
  "description": "Silla ejecutiva en cuero sintetico con reclinacion y apoyacabezas.",
  "price": 749000,
  "stock": 0,
  "categorySlug": "mobiliario",
  "images": [
    { "url": "https://media.example.com/prd-018-frente.png", "sortOrder": 0, "isPrimary": true },
    { "url": "https://media.example.com/prd-018-lateral.png", "sortOrder": 1, "isPrimary": false },
    { "url": "https://media.example.com/prd-018-detalle.png", "sortOrder": 2, "isPrimary": false }
  ],
  "variants": [
    { "publicId": "PRD-018-NEG", "name": "Negro", "price": 749000, "stock": 8 },
    { "publicId": "PRD-018-GRI", "name": "Gris", "price": 749000, "stock": 3 },
    { "publicId": "PRD-018-ROJ", "name": "Rojo", "price": 789000, "stock": 0 }
  ]
}

### Categorias
GET {{host}}/api/v1/categories
Accept: application/json

### Detalle de cliente
GET {{host}}/api/v1/customers/CUS-001
Accept: application/json

### Crear cliente
POST {{host}}/api/v1/customers
Content-Type: application/json

{
  "publicId": "CUS-004",
  "name": "Camila Duque",
  "email": "camila.duque@example.com",
  "source": "Website"
}

###
