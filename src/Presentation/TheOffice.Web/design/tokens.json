      "$type": "typography",
      "$value": {
        "fontFamily": "Rubik",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Fira Code",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
