{
  "name": "the-office-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "design:lint": "design.md lint DESIGN.md",
    "design:export": "design.md export --format dtcg DESIGN.md > design/tokens.json",
    "design:tokens": "pnpm design:export && node scripts/generate-theme.mjs",
    "design:check": "design.md export --format dtcg DESIGN.md | diff -u design/tokens.json - && node scripts/generate-theme.mjs --check",
    "design:classes": "node scripts/check-classes.mjs",
    "lint": "ng lint && prettier --check .",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@fontsource/aleo": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
