{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/"
    },
    {
      // Las pruebas corren en Vitest sobre jsdom, sin navegador: no hay URL de Karma que abrir.
      // Lanza `pnpm test -- --debug` en una terminal y engancha esta configuracion al inspector.
      "name": "ng test (adjuntar a `pnpm test -- --debug`)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
